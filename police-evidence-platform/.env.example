# Safe to commit — no real secrets. Copy to .env and fill in locally.
DATABASE_URL="file:../storage/app.db"
AUTH_SECRET=

# Optional. Real reverse-image search (Cloud Vision Web Detection) — the
# one capability in this build that genuinely requires network access and
# a billed GCP project, unlike everything else. Leave unset and the
# feature honestly reports itself unavailable instead of failing silently.
# Path to a GCP service-account JSON key (see secrets/README.md).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional. Real AI image description / possible-identity leads (Vertex AI
# Gemini) — separate credential from the Vision one above since it's a
# different API with its own least-privilege service account. Leave unset
# and the feature honestly reports itself unavailable.
GEMINI_APPLICATION_CREDENTIALS=
GEMINI_GCP_PROJECT_ID=
