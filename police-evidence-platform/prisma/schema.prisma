// Prisma schema for the Pramana Forensic Evidence Platform.
// Source of truth for this schema's design: ../../Docs/CH26/PS4_MVP_BUILD_PLAN.md §4.
//
// SQLite has no native enum type, so Prisma enums aren't available on this
// connector — fields that are conceptually enums are plain String columns
// with the allowed values documented in a comment; validation is enforced
// at the application layer (Zod schemas in the API route handlers), not the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Identity & access -------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // "investigator" | "admin" — enforced in route-handler guards, not the DB
  createdAt    DateTime @default(now())

  casesInvestigating Case[]            @relation("CaseInvestigator")
  evidenceUploaded   Evidence[]        @relation("EvidenceUploadedBy")
  auditEntries       AuditLogEntry[]   @relation("AuditActor")
  overridesGiven     VerdictOverride[] @relation("OverriddenBy")
  custodyTransfersRecorded CustodyTransfer[] @relation("CustodyTransferRecordedBy")
}

// --- Case ----------------------------------------------------------------

model Case {
  id      String @id // display ID, e.g. "CHD-2026-00131" — matches CCTNS-style case numbering
  firNumber String // required at creation — §1 item 8, no case exists without a real FIR link
  policeStation String
  district      String

  title             String
  summary           String?
  evidenceKind      String // "image" | "video" | "audio" | "document" — display-level; per-file truth is Evidence.mimeType
  status            String   @default("new") // "new" | "analyzing" | "review" | "closed"
  sensitivityLevel  String   @default("standard") // "standard" | "ncii" | "minor" — drives blur-by-default rendering, §2
  openedAt          DateTime @default(now())

  investigatorId       String
  investigator         User    @relation("CaseInvestigator", fields: [investigatorId], references: [id])
  investigatorRank     String?
  investigatorBadgeNo  String?
  investigatorMobile   String?

  // Real-world case-dossier particulars an actual IO report cannot be
  // filed without — added per a direct officer-style review of the
  // Section 63 BSA report export finding these genuinely missing, not
  // speculative. All optional: a case can be created and investigated
  // before some of these are known (e.g. accused is often unidentified at
  // intake), and the report is required to say so honestly rather than
  // block creation on fields that may not exist yet.
  offenceSections   String? // e.g. "IPC 66E, IT Act 67A" — the report cannot honestly omit this
  firDate           DateTime? // FIR registration date, distinct from firNumber
  complainantName   String?
  complainantContact String?
  accusedDetails    String? // free text — "unidentified" is a real, valid value here
  courtJurisdiction String? // e.g. "Court of the CJM, Chandigarh" — which court this is meant to be produced before
  gdEntryNumber     String? // General Diary / Roznamcha entry cross-reference

  // Real departmental dispatch number, assigned by the office's own DAK/
  // outward register once this report is actually sent out — distinct
  // from the system-generated provisional reference the report shows
  // until this is filled in (see RealReportPreview's header). Never
  // fabricated by the platform itself.
  dispatchNumber    String?

  // Forwarding/countersigning superior officer — real reports to a court
  // are forwarded through a chain of command, not signed only by the
  // preparing IO. Free-text fields (not a User relation) because the
  // forwarding officer is very often not a Pramana platform user.
  forwardingOfficerName     String?
  forwardingOfficerRank     String?
  forwardingOfficerBadgeNo  String?
  forwardingRemarks         String?
  forwardedAt               DateTime?

  evidence          Evidence[]
  auditEntries      AuditLogEntry[]
  propagationEdges  PropagationEdge[]

  @@index([investigatorId])
  @@index([firNumber])
}

// --- Evidence & analysis results -----------------------------------------

model Evidence {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id])
  // Deliberately NOT globally unique: the exact same file can legitimately be
  // evidence in more than one case (the same viral video reposted under two
  // separate complaints, say) — that's exactly the scenario EvidenceMatch/
  // cross-case search (§2, §4) exists to surface, not something to block at
  // the schema level. What *is* blocked: uploading the identical file twice
  // into the same case (the @@unique below), which is just an accidental
  // double-submit, not a real event.
  sha256           String
  phash            String? // perceptual hash, images/video frames only — null for audio/document (§4, EvidenceMatch/CorpusMatch)
  filePath         String
  mimeType         String
  uploadedAt       DateTime @default(now())
  uploadedById     String
  uploadedBy       User     @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
  deviceIdentifier String? // IMEI/MAC/serial — only when evidence comes from a specific seized device, not a generic upload
  casePropertyNumber String? // Malkhana / case-property register number — only meaningful alongside deviceIdentifier (a physically seized exhibit), never fabricated for a digital upload

  // Section 63/65B Part A declarant — the person who "was regularly using
  // the device in the ordinary course of the stated activity," which is
  // very often NOT the investigating officer (e.g. the complainant who
  // submitted a screenshot, or a platform's authorized signatory). Falls
  // back to the case's investigator in the report when unset, matching
  // the previous (narrower, legally imprecise) behavior — but now
  // overridable per exhibit instead of always assuming the IO.
  declarantName    String?
  declarantRole    String? // e.g. "Complainant", "Platform representative", "Investigating Officer (device in own custody)"
  declarantOrg     String?

  // Court order reference directing independent expert examination —
  // distinct from ForensicExpert (below), which only exists once the
  // expert's actual findings are in hand. This lets Part B honestly show
  // a middle "forwarding in progress" state instead of only "recorded" or
  // "not applicable".
  courtDirectionRef String?

  // Real provenance for a frame extracted from a video exhibit and saved
  // as its own image exhibit (see the extract-frame route) — a self
  // relation, not a free-text note, so the report/UI can always resolve
  // the actual source exhibit rather than trusting an unverifiable string.
  derivedFromEvidenceId      String?
  derivedFrom                Evidence?  @relation("EvidenceDerivedFrom", fields: [derivedFromEvidenceId], references: [id])
  derivatives                Evidence[] @relation("EvidenceDerivedFrom")
  derivedAtTimestampSeconds  Float?

  metadataResult   MetadataResult?
  detectionResult  DetectionResult?
  provenanceResult ProvenanceResult?
  forensicExpert   ForensicExpert?
  fusionVerdict    FusionVerdict?

  corpusMatches       CorpusMatch[]
  matchesFrom         EvidenceMatch[] @relation("EvidenceMatchSource")
  matchesTo           EvidenceMatch[] @relation("EvidenceMatchTarget")
  overrides           VerdictOverride[]
  custodyTransfers    CustodyTransfer[]

  @@unique([caseId, sha256])
  @@index([caseId])
  @@index([sha256])
  @@index([phash])
  @@index([derivedFromEvidenceId])
}

// Real physical chain-of-custody entries — seizure / handover / storage
// transfer, per exhibit. Deliberately separate from AuditLogEntry: that
// table is a system access log (who logged in and clicked what), which is
// not the same thing a court means by "chain of custody" for a physical
// exhibit (received from / handed to / independent witnesses). Only
// meaningful once an exhibit has left pure digital-upload territory, but
// not hard-restricted to that — an IO may want to log a transfer even for
// a digital file's storage medium.
model CustodyTransfer {
  id             String   @id @default(cuid())
  evidenceId     String
  evidence       Evidence @relation(fields: [evidenceId], references: [id])
  fromPerson     String
  toPerson       String
  purpose        String
  location       String?
  occurredAt     DateTime @default(now())
  witness1Name    String?
  witness1Address String?
  witness2Name    String?
  witness2Address String?
  recordedById   String
  recordedBy     User     @relation("CustodyTransferRecordedBy", fields: [recordedById], references: [id])
  recordedAt     DateTime @default(now())

  @@index([evidenceId])
}

model MetadataResult {
  id               String   @id @default(cuid())
  evidenceId       String   @unique
  evidence         Evidence @relation(fields: [evidenceId], references: [id])
  container        String?
  resolution       String?
  duration         String?
  codec            String?
  encoderSignature String?
  exifJson         String? // JSON-encoded — SQLite has no native JSON type
}

model DetectionResult {
  id                     String   @id @default(cuid())
  evidenceId             String   @unique
  evidence               Evidence @relation(fields: [evidenceId], references: [id])
  manipulationProbability Float
  heatmapPath            String?
  // Real MTCNN detection box, normalized [x1,y1,x2,y2] JSON array (0-1
  // fractions of the source image's width/height) -- null when no face was
  // detected, never a fabricated position.
  faceBoxJson            String?
  faceCropPath           String?
  // Real per-sampled-frame breakdown for video evidence, JSON array of
  // {timestampSeconds, probability, faceDetected}, ordered by timestamp —
  // every sampled frame was already scored by /investigate to find the
  // worst one; this is what was previously computed then discarded. Null
  // for image/audio evidence, which only ever has a single detection pass.
  frameScoresJson        String?
  modelName              String
  modelVersion           String
  ranAt                  DateTime @default(now())
}

model ProvenanceResult {
  id           String   @id @default(cuid())
  evidenceId   String   @unique
  evidence     Evidence @relation(fields: [evidenceId], references: [id])
  c2paPresent  Boolean  @default(false)
  c2paValid    Boolean  @default(false)
  manifestJson String?
}

// Part B of the Section 63 BSA certificate — only populated when a court has
// directed independent expert verification. Absence means "not applicable",
// never fabricated. See PS4_MVP_BUILD_PLAN.md §4 "Report format".
model ForensicExpert {
  id          String   @id @default(cuid())
  evidenceId  String   @unique
  evidence    Evidence @relation(fields: [evidenceId], references: [id])
  name        String
  designation String
  labRef      String
}

// --- Cross-case & seeded-corpus matching ---------------------------------

model CorpusItem {
  id             String   @id @default(cuid())
  sourcePlatform String
  sourceUrl      String
  firstSeenAt    DateTime
  sha256         String   @unique
  phash          String
  thumbnailPath  String

  corpusMatches    CorpusMatch[]
  propagationFrom  PropagationEdge[] @relation("PropagationFrom")
  propagationTo    PropagationEdge[] @relation("PropagationTo")
}

model CorpusMatch {
  id             String     @id @default(cuid())
  evidenceId     String
  evidence       Evidence   @relation(fields: [evidenceId], references: [id])
  corpusItemId   String
  corpusItem     CorpusItem @relation(fields: [corpusItemId], references: [id])
  similarity     Float
  hammingDistance Int

  @@index([evidenceId])
  @@index([corpusItemId])
}

// Cross-case search (§2, §4) — deliberately hash/pHash only for the MVP,
// not face-embedding based. Generalizes the same matching used against
// CorpusItem to run against every case's own evidence.
model EvidenceMatch {
  id               String   @id @default(cuid())
  evidenceId       String
  evidence         Evidence @relation("EvidenceMatchSource", fields: [evidenceId], references: [id])
  matchedEvidenceId String
  matchedEvidence  Evidence @relation("EvidenceMatchTarget", fields: [matchedEvidenceId], references: [id])
  matchedCaseId    String // denormalized for quick "which other case" lookups without an extra join
  matchType        String // "sha256_exact" | "phash_near"
  similarity       Float
  hammingDistance  Int

  @@index([evidenceId])
  @@index([matchedCaseId])
}

model PropagationEdge {
  id                String     @id @default(cuid())
  caseId            String
  case              Case       @relation(fields: [caseId], references: [id])
  fromCorpusItemId  String
  fromCorpusItem    CorpusItem @relation("PropagationFrom", fields: [fromCorpusItemId], references: [id])
  toCorpusItemId    String
  toCorpusItem      CorpusItem @relation("PropagationTo", fields: [toCorpusItemId], references: [id])
  timeDeltaLabel    String

  @@index([caseId])
}

// --- Fusion, override, audit ----------------------------------------------

// Coverage-aware Evidence Fusion — see PS4_MVP_BUILD_PLAN.md §4 "Fusion algorithm"
// for the exact coverageCount/confidenceCeiling capping logic this schema backs.
model FusionVerdict {
  id                 String   @id @default(cuid())
  evidenceId         String   @unique
  evidence           Evidence @relation(fields: [evidenceId], references: [id])
  verdict            String // "AUTHENTIC" | "MANIPULATED" | "AI_GENERATED" | "INCONCLUSIVE"
  confidence         Int // 0-100, post-cap displayed confidence
  coverageCount      Int // 0-3 corroborating signals that fired
  confidenceCeiling  Int // 60 + coverageCount*13, per the fusion algorithm spec
  explanation        String
  signalBreakdownJson String // each corroborating check recorded as fired/absent/contradicted — never omitted
  computedAt         DateTime @default(now())
}

model VerdictOverride {
  id               String   @id @default(cuid())
  evidenceId       String
  evidence         Evidence @relation(fields: [evidenceId], references: [id])
  overriddenById   String
  overriddenBy     User     @relation("OverriddenBy", fields: [overriddenById], references: [id])
  previousVerdict  String
  newVerdict       String
  reason           String
  timestamp        DateTime @default(now())

  @@index([evidenceId])
}

// Append-only, hash-chained (§1 item 10, §2). entryHash/prevEntryHash form a
// chain from the very first entry; prevEntryHash is null only for entry #1.
// Every write here is mirrored to storage/audit-checkpoints.log (chattr +a)
// per §2 — that mirroring happens at the application layer, not in this schema.
//
// `id` is a plain autoincrementing integer here (unlike every other model's
// cuid) deliberately: the hash chain must know entry #1, #2, #3... in strict,
// unambiguous order to find "the previous entry," and cuid ordering is not a
// safe substitute for that — an autoincrement primary key is.
model AuditLogEntry {
  id            Int      @id @default(autoincrement())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id])
  evidenceHash  String?
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id])
  action        String // "UPLOADED" | "ANALYZED" | "VIEWED" | "OVERRIDDEN" | "EXPORTED" | "ASSIGNED" | "CUSTODY_TRANSFERRED"
  timestamp     DateTime @default(now())
  device        String?
  entryHash     String   @unique
  prevEntryHash String?

  @@index([caseId])
  @@index([timestamp])
}
