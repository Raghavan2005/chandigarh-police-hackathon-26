// Prisma schema for the Pramana Forensic Evidence Platform.
// Source of truth for this schema's design: ../../Docs/CH26/PS4_MVP_BUILD_PLAN.md §4.
//
// SQLite has no native enum type, so Prisma enums aren't available on this
// connector — fields that are conceptually enums are plain String columns
// with the allowed values documented in a comment; validation is enforced
// at the application layer (Zod schemas in the API route handlers), not the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Identity & access -------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // "investigator" | "admin" — enforced in route-handler guards, not the DB
  createdAt    DateTime @default(now())

  casesInvestigating Case[]            @relation("CaseInvestigator")
  evidenceUploaded   Evidence[]        @relation("EvidenceUploadedBy")
  auditEntries       AuditLogEntry[]   @relation("AuditActor")
  overridesGiven     VerdictOverride[] @relation("OverriddenBy")
  custodyTransfersRecorded CustodyTransfer[] @relation("CustodyTransferRecordedBy")
  captureLinksCreated CaptureLink[]    @relation("CaptureLinkCreatedBy")
  investigationsCreated   Investigation[]     @relation("InvestigationCreatedBy")
  investigationLinksMade  InvestigationCase[] @relation("InvestigationCaseLinkedBy")
  investigationLinksRemoved InvestigationCase[] @relation("InvestigationCaseUnlinkedBy")
  investigationActorsAdded   InvestigationActor[] @relation("InvestigationActorAddedBy")
  investigationActorsRemoved InvestigationActor[] @relation("InvestigationActorRemovedBy")
  alertsTargeted     Alert[] @relation("AlertTargetUser")
  alertsAcknowledged Alert[] @relation("AlertAcknowledgedBy")
}

// --- Case ----------------------------------------------------------------

model Case {
  id      String @id // display ID, e.g. "CHD-2026-00131" — matches CCTNS-style case numbering
  firNumber String // required at creation — §1 item 8, no case exists without a real FIR link
  policeStation String
  district      String

  title             String
  summary           String?
  evidenceKind      String // "image" | "video" | "audio" | "document" — display-level; per-file truth is Evidence.mimeType
  status            String   @default("new") // "new" | "analyzing" | "review" | "closed"
  sensitivityLevel  String   @default("standard") // "standard" | "ncii" | "minor" — drives blur-by-default rendering, §2
  openedAt          DateTime @default(now())

  investigatorId       String
  investigator         User    @relation("CaseInvestigator", fields: [investigatorId], references: [id])
  investigatorRank     String?
  investigatorBadgeNo  String?
  investigatorMobile   String?

  // Real-world case-dossier particulars an actual IO report cannot be
  // filed without — added per a direct officer-style review of the
  // Section 63 BSA report export finding these genuinely missing, not
  // speculative. All optional: a case can be created and investigated
  // before some of these are known (e.g. accused is often unidentified at
  // intake), and the report is required to say so honestly rather than
  // block creation on fields that may not exist yet.
  offenceSections   String? // e.g. "IPC 66E, IT Act 67A" — the report cannot honestly omit this
  firDate           DateTime? // FIR registration date, distinct from firNumber
  complainantName   String?
  complainantContact String?
  accusedDetails    String? // free text — "unidentified" is a real, valid value here
  courtJurisdiction String? // e.g. "Court of the CJM, Chandigarh" — which court this is meant to be produced before
  gdEntryNumber     String? // General Diary / Roznamcha entry cross-reference

  // Real departmental dispatch number, assigned by the office's own DAK/
  // outward register once this report is actually sent out — distinct
  // from the system-generated provisional reference the report shows
  // until this is filled in (see RealReportPreview's header). Never
  // fabricated by the platform itself.
  dispatchNumber    String?

  // Forwarding/countersigning superior officer — real reports to a court
  // are forwarded through a chain of command, not signed only by the
  // preparing IO. Free-text fields (not a User relation) because the
  // forwarding officer is very often not a Pramana platform user.
  forwardingOfficerName     String?
  forwardingOfficerRank     String?
  forwardingOfficerBadgeNo  String?
  forwardingRemarks         String?
  forwardedAt               DateTime?

  evidence          Evidence[]
  auditEntries      AuditLogEntry[]
  propagationEdges  PropagationEdge[]
  captureLinks      CaptureLink[]
  investigationLinks InvestigationCase[]
  alerts            Alert[]

  @@index([investigatorId])
  @@index([firNumber])
}

// A photo captured from the fixed, public /capture page (no token, no case
// yet — used from the "New case" wizard, before a case exists to scope
// anything to). Deliberately unauthenticated on the write side: anyone who
// can reach this server on the demo LAN can POST one — acceptable only for
// a controlled-network hackathon demo, same trade-off as CaptureLink below,
// just without even a token. Read side (latest/consume) stays
// authenticated so only a logged-in investigator's new-case tab picks it
// up. `consumedAt` is set once a wizard has pulled it into its form, so it
// isn't offered to a second tab or reappear on reload.
model PendingCapture {
  id         String    @id @default(cuid())
  sha256     String    @unique
  filePath   String
  mimeType   String
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([consumedAt])
}

// Short-lived, case-scoped, single-purpose token for the no-login "tablet
// quick capture" demo flow — not a general share/guest link. Authorizes
// exactly one thing: upload one photo into `caseId` and auto-run detection
// on it. No read access to existing case data. Unguessability (32 random
// bytes) + a several-hour expiry is the entire security model — acceptable
// for a controlled-network hackathon demo, not production-grade.
model CaptureLink {
  id              String    @id @default(cuid())
  token           String    @unique
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id])
  createdByUserId String
  createdBy       User      @relation("CaptureLinkCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  usedAt          DateTime? // last successful capture — informational, not single-use (a demo may capture more than one photo)

  @@index([caseId])
  @@index([expiresAt])
}

// --- Evidence & analysis results -----------------------------------------

model Evidence {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id])
  // Deliberately NOT globally unique: the exact same file can legitimately be
  // evidence in more than one case (the same viral video reposted under two
  // separate complaints, say) — that's exactly the scenario EvidenceMatch/
  // cross-case search (§2, §4) exists to surface, not something to block at
  // the schema level. What *is* blocked: uploading the identical file twice
  // into the same case (the @@unique below), which is just an accidental
  // double-submit, not a real event.
  sha256           String
  phash            String? // perceptual hash, images/video frames only — null for audio/document (§4, EvidenceMatch/CorpusMatch)
  filePath         String
  mimeType         String
  uploadedAt       DateTime @default(now())
  uploadedById     String
  uploadedBy       User     @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
  deviceIdentifier String? // IMEI/MAC/serial — only when evidence comes from a specific seized device, not a generic upload
  casePropertyNumber String? // Malkhana / case-property register number — only meaningful alongside deviceIdentifier (a physically seized exhibit), never fabricated for a digital upload

  // Evidence Vault (Docs/Plan for the feature) Phase C — retention/legal-hold
  // flags, surfaced there as "expiring soon" / "on hold" filters. Flags
  // only: no disposal/deletion workflow exists yet, so retentionUntil
  // passing never deletes anything by itself.
  retentionUntil DateTime?
  legalHold      Boolean   @default(false)

  // Section 63/65B Part A declarant — the person who "was regularly using
  // the device in the ordinary course of the stated activity," which is
  // very often NOT the investigating officer (e.g. the complainant who
  // submitted a screenshot, or a platform's authorized signatory). Falls
  // back to the case's investigator in the report when unset, matching
  // the previous (narrower, legally imprecise) behavior — but now
  // overridable per exhibit instead of always assuming the IO.
  declarantName    String?
  declarantRole    String? // e.g. "Complainant", "Platform representative", "Investigating Officer (device in own custody)"
  declarantOrg     String?

  // Court order reference directing independent expert examination —
  // distinct from ForensicExpert (below), which only exists once the
  // expert's actual findings are in hand. This lets Part B honestly show
  // a middle "forwarding in progress" state instead of only "recorded" or
  // "not applicable".
  courtDirectionRef String?

  // Real provenance for a frame extracted from a video exhibit and saved
  // as its own image exhibit (see the extract-frame route) — a self
  // relation, not a free-text note, so the report/UI can always resolve
  // the actual source exhibit rather than trusting an unverifiable string.
  derivedFromEvidenceId      String?
  derivedFrom                Evidence?  @relation("EvidenceDerivedFrom", fields: [derivedFromEvidenceId], references: [id])
  derivatives                Evidence[] @relation("EvidenceDerivedFrom")
  derivedAtTimestampSeconds  Float?

  metadataResult   MetadataResult?
  detectionResult  DetectionResult?
  provenanceResult ProvenanceResult?
  forensicExpert   ForensicExpert?
  fusionVerdict    FusionVerdict?
  reverseImageSearchResult ReverseImageSearchResult?
  imageDescriptionResult   ImageDescriptionResult?
  transcriptResult         TranscriptResult?

  corpusMatches       CorpusMatch[]
  matchesFrom         EvidenceMatch[] @relation("EvidenceMatchSource")
  matchesTo           EvidenceMatch[] @relation("EvidenceMatchTarget")
  overrides           VerdictOverride[]
  custodyTransfers    CustodyTransfer[]
  faceAnnotations     FaceAnnotation[]
  alerts              Alert[]

  @@unique([caseId, sha256])
  @@index([caseId])
  @@index([sha256])
  @@index([phash])
  @@index([derivedFromEvidenceId])
}

// Real physical chain-of-custody entries — seizure / handover / storage
// transfer, per exhibit. Deliberately separate from AuditLogEntry: that
// table is a system access log (who logged in and clicked what), which is
// not the same thing a court means by "chain of custody" for a physical
// exhibit (received from / handed to / independent witnesses). Only
// meaningful once an exhibit has left pure digital-upload territory, but
// not hard-restricted to that — an IO may want to log a transfer even for
// a digital file's storage medium.
model CustodyTransfer {
  id             String   @id @default(cuid())
  evidenceId     String
  evidence       Evidence @relation(fields: [evidenceId], references: [id])
  fromPerson     String
  toPerson       String
  purpose        String
  location       String?
  occurredAt     DateTime @default(now())
  witness1Name    String?
  witness1Address String?
  witness2Name    String?
  witness2Address String?
  recordedById   String
  recordedBy     User     @relation("CustodyTransferRecordedBy", fields: [recordedById], references: [id])
  recordedAt     DateTime @default(now())

  @@index([evidenceId])
}

model MetadataResult {
  id               String   @id @default(cuid())
  evidenceId       String   @unique
  evidence         Evidence @relation(fields: [evidenceId], references: [id])
  container        String?
  resolution       String?
  duration         String?
  codec            String?
  encoderSignature String?
  exifJson         String? // JSON-encoded — SQLite has no native JSON type
}

model DetectionResult {
  id                     String   @id @default(cuid())
  evidenceId             String   @unique
  evidence               Evidence @relation(fields: [evidenceId], references: [id])
  manipulationProbability Float
  heatmapPath            String?
  // Every real MTCNN detection box, JSON array of [x1,y1,x2,y2] (0-1
  // fractions of the source image's width/height), sorted by detection
  // probability descending -- "[]" when no face was detected, never a
  // fabricated position. faceCropPathsJson[0] is always the same face as
  // faceBoxesJson[0] -- the model only ever classifies one face per image,
  // the rest are plain display-only crops, never separately classified.
  faceBoxesJson          String   @default("[]")
  faceCropPathsJson      String   @default("[]")
  // Real per-sampled-frame breakdown for video evidence, JSON array of
  // {timestampSeconds, probability, faceDetected}, ordered by timestamp —
  // every sampled frame was already scored by /investigate to find the
  // worst one; this is what was previously computed then discarded. Null
  // for image/audio evidence, which only ever has a single detection pass.
  frameScoresJson        String?
  modelName              String
  modelVersion           String
  ranAt                  DateTime @default(now())
}

model ProvenanceResult {
  id           String   @id @default(cuid())
  evidenceId   String   @unique
  evidence     Evidence @relation(fields: [evidenceId], references: [id])
  c2paPresent  Boolean  @default(false)
  c2paValid    Boolean  @default(false)
  manifestJson String?
}

// Part B of the Section 63 BSA certificate — only populated when a court has
// directed independent expert verification. Absence means "not applicable",
// never fabricated. See PS4_MVP_BUILD_PLAN.md §4 "Report format".
model ForensicExpert {
  id          String   @id @default(cuid())
  evidenceId  String   @unique
  evidence    Evidence @relation(fields: [evidenceId], references: [id])
  name        String
  designation String
  labRef      String
}

// Real Whisper transcription (ml-service, local — see transcriber.py),
// cached per exhibit for the same reason as ReverseImageSearchResult below:
// a real (if local, not billed) compute-heavy call that shouldn't silently
// re-run every time a case is reopened. Audio and video evidence only.
model TranscriptResult {
  id           String   @id @default(cuid())
  evidenceId   String   @unique
  evidence     Evidence @relation(fields: [evidenceId], references: [id])
  language     String // ISO-639-1-ish code Whisper detected, e.g. "en", "hi"
  segmentsJson String // JSON array of {start: number, end: number, text: string}, seconds
  truncated    Boolean  @default(false) // true if the source file was longer than transcriber.py's MAX_SECONDS and got cut
  ranAt        DateTime @default(now())

  // Real Silero VAD check (speech_validator.py), independent of Whisper's
  // own output — null until an investigator explicitly runs "Validate
  // speech" (never automatic; §8 avoid unnecessary model calls). Guards
  // against Whisper's known failure mode of hallucinating plausible text
  // over silence/music/noise: a non-empty transcript alone doesn't prove
  // the clip actually contains speech.
  hasSpeech       Boolean?
  speechRatio     Float? // 0-1, fraction of the clip VAD classified as speech
  speechValidatedAt DateTime?

  translations TranscriptTranslation[]
}

// One cached translation of a TranscriptResult into a target language —
// separate rows per language rather than overwriting, since an
// investigator may want more than one target language's captions
// available on the same exhibit without re-running the model each time
// they switch back.
model TranscriptTranslation {
  id                 String           @id @default(cuid())
  transcriptResultId String
  transcriptResult   TranscriptResult @relation(fields: [transcriptResultId], references: [id])
  targetLang         String // ISO-639-1-ish code, e.g. "hi"
  segmentsJson       String // Same shape as TranscriptResult.segmentsJson, translated text
  ranAt              DateTime         @default(now())

  @@unique([transcriptResultId, targetLang])
}

// Real reverse-image search results (Cloud Vision Web Detection), cached
// per exhibit — direct user request: re-running a real, billed external
// lookup every single time a case is reopened is wasteful and slow, not
// something an investigator would want. Explicitly timestamped (`ranAt`)
// and always re-runnable from the UI, so a stored result is presented
// honestly as "as of this time," never implied to be freshly re-fetched
// on every page load the way it would be dishonest to imply for a
// classifier score computed once and never re-checked.
model ReverseImageSearchResult {
  id                   String   @id @default(cuid())
  evidenceId           String   @unique
  evidence             Evidence @relation(fields: [evidenceId], references: [id])
  fullMatchesJson      String
  partialMatchesJson   String
  pagesWithMatchesJson String
  webEntitiesJson      String
  bestGuessLabelsJson  String   @default("[]")
  labelsJson           String   @default("[]")
  ranAt                DateTime @default(now())
}

// Real Vertex AI Gemini image description — separate cache/table from
// ReverseImageSearchResult above since it's a different API/credential
// with different reliability characteristics (a language model's
// best-effort visual judgment, not Vision API's web-index matching), and
// is the only capability able to name a recognizable person at all.
// Cached like the Vision result: a real, billed external call, so re-run
// on demand rather than on every page load.
model ImageDescriptionResult {
  id                     String   @id @default(cuid())
  evidenceId             String   @unique
  evidence               Evidence @relation(fields: [evidenceId], references: [id])
  description            String
  possibleIdentitiesJson String
  ranAt                  DateTime @default(now())
}

// Per-face annotation — a manual label plus cached reverse-image-search /
// AI-description results scoped to one individual detected face crop
// (DetectionResult.faceBoxesJson[faceIndex]), not the whole exhibit.
// Deliberately keyed by (evidenceId, faceIndex) rather than a stable
// per-face ID: MTCNN doesn't track face identity across runs, so a
// re-investigate that changes which faces are found (or their probability
// ordering) can shift which face a given index refers to — an accepted,
// documented limitation, not silently glossed over.
model FaceAnnotation {
  id                 String    @id @default(cuid())
  evidenceId         String
  evidence           Evidence  @relation(fields: [evidenceId], references: [id])
  faceIndex          Int
  label              String?
  reverseSearchJson  String?
  reverseSearchRanAt DateTime?
  descriptionJson    String?
  descriptionRanAt   DateTime?
  updatedAt          DateTime  @updatedAt

  @@unique([evidenceId, faceIndex])
}

// --- Cross-case & seeded-corpus matching ---------------------------------

model CorpusItem {
  id             String   @id @default(cuid())
  sourcePlatform String
  sourceUrl      String
  firstSeenAt    DateTime
  sha256         String   @unique
  phash          String
  thumbnailPath  String

  corpusMatches    CorpusMatch[]
  propagationFrom  PropagationEdge[] @relation("PropagationFrom")
  propagationTo    PropagationEdge[] @relation("PropagationTo")
}

model CorpusMatch {
  id             String     @id @default(cuid())
  evidenceId     String
  evidence       Evidence   @relation(fields: [evidenceId], references: [id])
  corpusItemId   String
  corpusItem     CorpusItem @relation(fields: [corpusItemId], references: [id])
  similarity     Float
  hammingDistance Int

  @@index([evidenceId])
  @@index([corpusItemId])
}

// Cross-case search (§2, §4) — deliberately hash/pHash only for the MVP,
// not face-embedding based. Generalizes the same matching used against
// CorpusItem to run against every case's own evidence.
model EvidenceMatch {
  id               String   @id @default(cuid())
  evidenceId       String
  evidence         Evidence @relation("EvidenceMatchSource", fields: [evidenceId], references: [id])
  matchedEvidenceId String
  matchedEvidence  Evidence @relation("EvidenceMatchTarget", fields: [matchedEvidenceId], references: [id])
  matchedCaseId    String // denormalized for quick "which other case" lookups without an extra join
  matchType        String // "sha256_exact" | "phash_near"
  similarity       Float
  hammingDistance  Int

  @@index([evidenceId])
  @@index([matchedCaseId])
}

model PropagationEdge {
  id                String     @id @default(cuid())
  caseId            String
  case              Case       @relation(fields: [caseId], references: [id])
  fromCorpusItemId  String
  fromCorpusItem    CorpusItem @relation("PropagationFrom", fields: [fromCorpusItemId], references: [id])
  toCorpusItemId    String
  toCorpusItem      CorpusItem @relation("PropagationTo", fields: [toCorpusItemId], references: [id])
  timeDeltaLabel    String

  @@index([caseId])
}

// --- Fusion, override, audit ----------------------------------------------

// Coverage-aware Evidence Fusion — see PS4_MVP_BUILD_PLAN.md §4 "Fusion algorithm"
// for the exact coverageCount/confidenceCeiling capping logic this schema backs.
model FusionVerdict {
  id                 String   @id @default(cuid())
  evidenceId         String   @unique
  evidence           Evidence @relation(fields: [evidenceId], references: [id])
  verdict            String // "AUTHENTIC" | "MANIPULATED" | "AI_GENERATED" | "INCONCLUSIVE"
  confidence         Int // 0-100, post-cap displayed confidence
  coverageCount      Int // 0-3 corroborating signals that fired
  confidenceCeiling  Int // 60 + coverageCount*13, per the fusion algorithm spec
  explanation        String
  signalBreakdownJson String // each corroborating check recorded as fired/absent/contradicted — never omitted
  computedAt         DateTime @default(now())
}

model VerdictOverride {
  id               String   @id @default(cuid())
  evidenceId       String
  evidence         Evidence @relation(fields: [evidenceId], references: [id])
  overriddenById   String
  overriddenBy     User     @relation("OverriddenBy", fields: [overriddenById], references: [id])
  previousVerdict  String
  newVerdict       String
  reason           String
  timestamp        DateTime @default(now())

  @@index([evidenceId])
}

// Append-only, hash-chained (§1 item 10, §2). entryHash/prevEntryHash form a
// chain from the very first entry; prevEntryHash is null only for entry #1.
// Every write here is mirrored to storage/audit-checkpoints.log (chattr +a)
// per §2 — that mirroring happens at the application layer, not in this schema.
//
// `id` is a plain autoincrementing integer here (unlike every other model's
// cuid) deliberately: the hash chain must know entry #1, #2, #3... in strict,
// unambiguous order to find "the previous entry," and cuid ordering is not a
// safe substitute for that — an autoincrement primary key is.
model AuditLogEntry {
  id            Int      @id @default(autoincrement())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id])
  evidenceHash  String?
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id])
  action        String // "UPLOADED" | "ANALYZED" | "VIEWED" | "OVERRIDDEN" | "EXPORTED" | "ASSIGNED" | "CUSTODY_TRANSFERRED"
  timestamp     DateTime @default(now())
  device        String?
  entryHash     String   @unique
  prevEntryHash String?

  @@index([caseId])
  @@index([timestamp])
}

// --- Investigations (Docs/Plan for the feature) --------------------------
// A layer above Case: groups multiple cases believed connected to the same
// real-world actor/campaign (e.g. the same account behind two separate
// FIRs — see Docs/incidents' cross-case @-handle link between the Dwivedi
// and Modi-Netanyahu dossiers, which today has no representation in the
// system at all). Every link is investigator-asserted with a required
// justification, never computed — same anti-overclaiming rule the Fusion
// verdict and declarant fields already follow. Distinct from
// EvidenceMatch/CorpusMatch, which link cases that share an actual file;
// an Investigation links cases that share an actor, often with no shared
// file at all.
model Investigation {
  id          String   @id // display ID, e.g. "INV-2026-00001" — mirrors Case's CHD-{year}-{seq} convention
  title       String
  summary     String?
  status      String   @default("open") // "open" | "closed"
  createdById String
  createdBy   User     @relation("InvestigationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  cases  InvestigationCase[]
  actors InvestigationActor[]
}

// Join table, not a plain many-to-many: linking (and unlinking) a case is
// itself an assertion that needs a recorded basis, not just a fact. Rows
// are never deleted on unlink — matching this app's append-only-history
// pattern elsewhere (evidence is never deleted, the audit log is
// append-only) — unlinkedAt/unlinkedById/unlinkReason record that a link
// existed and was later removed, and why, instead of erasing it.
model InvestigationCase {
  id              String    @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id])
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id])
  justification   String // required — the recorded reasonable-suspicion basis for this link
  linkedById      String
  linkedBy        User      @relation("InvestigationCaseLinkedBy", fields: [linkedById], references: [id])
  linkedAt        DateTime  @default(now())
  unlinkedById    String?
  unlinkedBy      User?     @relation("InvestigationCaseUnlinkedBy", fields: [unlinkedById], references: [id])
  unlinkedAt      DateTime?
  unlinkReason    String?

  // Deliberately no @@unique([investigationId, caseId]): a case can be
  // linked, unlinked, and later re-linked (e.g. new evidence revives a
  // connection previously deemed too weak) — each such event is its own
  // row, not one slot overwritten in place. The application layer checks
  // for an existing *active* (unlinkedAt: null) link before creating a new
  // one instead.
  @@index([investigationId])
  @@index([caseId])
}

// Phase B (Docs/Plan for the feature) — a suspected handle/account believed
// relevant to an investigation. Explicitly a working lead, never a verified
// identity match: `note` records why it's suspected, same as-stated-basis
// rule the Fusion verdict and case-linking justification already follow.
// Lower-stakes than linking a case (no FIR/legal consequence), so any
// authenticated investigator can add/remove one, not admin-only like
// case-linking. Not tied to AuditLogEntry — that table requires a caseId
// and an actor note isn't about any one specific linked case; addedBy/At
// and removedBy/At/Reason already give this its own full accountability
// trail without forcing an arbitrary case attribution.
model InvestigationActor {
  id              String    @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id])
  platform        String // e.g. "telegram" | "x" | "facebook" | "whatsapp" | "news" | "public-record" — free text, matching CorpusItem.sourcePlatform's own precedent, not DB-enforced
  handle          String
  note            String?
  addedById       String
  addedBy         User      @relation("InvestigationActorAddedBy", fields: [addedById], references: [id])
  addedAt         DateTime  @default(now())
  removedById     String?
  removedBy       User?     @relation("InvestigationActorRemovedBy", fields: [removedById], references: [id])
  removedAt       DateTime?
  removeReason    String?

  @@index([investigationId])
}

// Alerts — surfaces four event types without requiring anyone to already
// know to look: a new case assigned, a MANIPULATED/AI_GENERATED verdict,
// a cross-case hash match, and (the highest-operational-risk one, per the
// jury-panel-style review of this feature) the tamper-evident audit log
// failing its own integrity check. targetUserId null means platform-wide
// (only used for AUDIT_INTEGRITY_FAILURE, admin-only per the /audit page's
// own gate). Acknowledged, never deleted — same append-only pattern as
// everything else accountability-adjacent in this app.
model Alert {
  id               String    @id @default(cuid())
  type             String // "CASE_ASSIGNED" | "MANIPULATED_VERDICT" | "CROSS_CASE_MATCH" | "AUDIT_INTEGRITY_FAILURE"
  severity         String // "critical" | "warning" | "info"
  message          String
  caseId           String?
  case             Case?     @relation(fields: [caseId], references: [id])
  evidenceId       String?
  evidence         Evidence? @relation(fields: [evidenceId], references: [id])
  targetUserId     String? // null = every admin (platform-wide alert)
  targetUser       User?     @relation("AlertTargetUser", fields: [targetUserId], references: [id])
  createdAt        DateTime  @default(now())
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  @@index([targetUserId])
  @@index([caseId])
  @@index([createdAt])
}
