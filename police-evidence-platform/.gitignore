# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the safe example committed, never the real one
.env*
!.env.example

# runtime data — DB file, uploads, generated reports, audit checkpoint log
# (per PS4_MVP_BUILD_PLAN.md §2: none of this belongs in source control)
/storage/*.db
/storage/*.db-journal
/storage/audit-checkpoints.log
/storage/uploads/*
/storage/reports/*
/storage/heatmaps/*
/storage/face-crops/*
!/storage/uploads/.gitkeep
!/storage/reports/.gitkeep
!/storage/heatmaps/.gitkeep
!/storage/face-crops/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
